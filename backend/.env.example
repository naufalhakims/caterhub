# Port API (default 4000)
API_PORT="4000"

# Origin yang diizinkan memanggil API dari browser.
# Server Next memanggil server-to-server sehingga tidak butuh CORS, tetapi
# ini disiapkan untuk konsumen browser di masa depan.
CORS_ORIGIN="http://localhost:3000"

# DATABASE_URL diambil otomatis dari .env root repo.
# Isi di sini hanya bila ingin memakai database lain:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caterhub?schema=public"
