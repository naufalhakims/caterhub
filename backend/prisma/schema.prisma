generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  NEEDS_INFO
  VERIFIED
  REJECTED
}

enum VendorDocumentType {
  BUSINESS_LICENSE
  PREMISES_PHOTO
  KITCHEN_PHOTO
  MENU_PACKAGE
  OTHER
}

enum EventType {
  WEDDING
  BIRTHDAY
  CORPORATE
  MEETING
  SEMINAR
  GATHERING
  GRADUATION
  OTHER
}

enum QuotationStatus {
  DRAFT
  REQUESTED
  SENT
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
  DECLINED
  EXPIRED
}

enum QuotationOrigin {
  CUSTOMER_REQUEST
  VENDOR_OFFER
  VENDOR_OFFLINE // dicatat vendor dari pesanan WA/telepon
}

enum BookingStatus {
  QUOTATION_PENDING
  QUOTATION_SENT
  REVISION_REQUESTED
  CONFIRMED
  PAYMENT_PENDING
  PAID
  PREPARING
  READY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  FAILED
  EXPIRED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  phone         String?
  address       String?
  city          String?
  /// Izin menerima notifikasi WhatsApp (dipakai bila nomor telepon terisi).
  whatsappOptIn Boolean   @default(true)
  /// Naik setiap ganti kata sandi → semua sesi lama (JWT dengan versi lama) ditolak.
  tokenVersion  Int       @default(0)
  /// Akun tersembunyi pemilik pesanan offline (satu per vendor); tidak bisa login.
  isPlaceholder Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  vendorProfile VendorProfile?
  events        Event[]        @relation("CustomerEvents")
  quotationsAsCustomer Quotation[] @relation("CustomerQuotations")
  bookingsAsCustomer   Booking[]   @relation("CustomerBookings")
  reviews       Review[]
  notifications Notification[]
  whatsappMessages WhatsAppMessage[]
  offerMessages OfferMessage[] @relation("OfferMessages")
  quotationActions QuotationHistory[] @relation("QuotationHistoryActor")

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VendorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  businessName       String
  description        String?
  phone              String?
  address            String?
  city               String             @default("Surabaya")
  latitude           Float?
  longitude          Float?
  /// Tarif ongkir: dasar untuk N km pertama, lalu per km (dibulatkan ke atas), hingga radius maks.
  deliveryBaseFee    Int                @default(15000)
  deliveryBaseKm     Float              @default(3)
  deliveryPerKm      Int                @default(4000)
  deliveryMaxKm      Float              @default(25)
  verificationStatus VerificationStatus @default(PENDING)
  verificationNote   String?
  reviewedAt         DateTime?
  reviewedById       String?
  logoUrl            String?
  coverUrl           String?
  gallery            String[]           @default([])
  rating             Float              @default(0)
  reviewCount        Int                @default(0)
  minPax             Int                @default(50)
  maxPax             Int                @default(500)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  packages     Package[]
  ingredients  Ingredient[]
  availability Availability[]
  quotations   Quotation[]    @relation("VendorQuotations")
  bookings     Booking[]      @relation("VendorBookings")
  reviews      Review[]
  documents    VendorDocument[]
  invoiceCounters InvoiceCounter[]

  @@index([city])
  @@index([verificationStatus])
}

model VendorDocument {
  id           String             @id @default(cuid())
  vendorId     String
  type         VendorDocumentType
  title        String?
  fileName     String
  storageKey   String             @unique
  mimeType     String
  sizeBytes    Int
  uploadedById String?
  createdAt    DateTime           @default(now())

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([type])
}

model Event {
  id         String    @id @default(cuid())
  customerId String
  name       String
  eventType  EventType
  eventDate  DateTime
  eventTime  String?
  location   String
  city       String    @default("Surabaya")
  guestCount Int
  /// Titik lokasi acara (pin peta) untuk menghitung jarak & ongkir.
  latitude   Float?
  longitude  Float?
  budgetMin  Int?
  budgetMax  Int?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer   User        @relation("CustomerEvents", fields: [customerId], references: [id], onDelete: Cascade)
  quotations Quotation[]
  bookings   Booking[]

  @@index([customerId])
  @@index([eventDate])
}

model MenuItem {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  description String?
  category    String   @default("Lauk")
  price       Int      @default(0) // add-on price per pax, IDR
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  packages PackageItem[]
  recipe   MenuItemIngredient[]
  quotationItems QuotationItem[]

  @@index([vendorId])
}

/// Bahan baku vendor, dihargai per satuan beli (kg / liter / pcs).
model Ingredient {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  unit        String   @default("kg") // kg | liter | pcs
  pricePerUnit Int     @default(0) // IDR per satuan beli
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor  VendorProfile        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  recipes MenuItemIngredient[]

  @@unique([vendorId, name])
  @@index([vendorId])
}

/// Resep: kebutuhan bahan per porsi menu (gram untuk kg, ml untuk liter, pcs untuk pcs).
model MenuItemIngredient {
  menuItemId   String
  ingredientId String
  quantity     Float

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([menuItemId, ingredientId])
  @@index([ingredientId])
}

model Package {
  id          String   @id @default(cuid())
  vendorId    String
  name        String
  description String?
  pricePerPax Int // IDR per pax
  otherCostPerPax Int @default(0) // kemasan, gas, tenaga — bagian HPP di luar bahan baku
  minPax      Int      @default(50)
  maxPax      Int      @default(500)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  items    PackageItem[]
  quotations Quotation[]

  @@index([vendorId])
  @@index([isActive])
}

model PackageItem {
  packageId  String
  menuItemId String

  package  Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([packageId, menuItemId])
}

model Availability {
  id          String   @id @default(cuid())
  vendorId    String
  date        DateTime @db.Date
  maxPax      Int      @default(500)
  reservedPax Int      @default(0)

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, date])
  @@index([date])
}

model Quotation {
  id          String          @id @default(cuid())
  eventId     String
  packageId   String?
  vendorId    String
  customerId  String
  status      QuotationStatus @default(DRAFT)
  origin      QuotationOrigin @default(VENDOR_OFFER)
  subtotal    Int             @default(0)
  deliveryFee Int             @default(0)
  serviceFee  Int             @default(0)
  discount    Int             @default(0)
  total       Int             @default(0) // snapshot harga saat kirim/terima
  notes       String?
  expiresAt   DateTime?
  revisionNote String?
  /// Snapshot jarak (km, perkiraan jalan) & ongkir sesuai tarif saat permintaan dibuat.
  distanceKm  Float?
  suggestedDeliveryFee Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  package  Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  vendor   VendorProfile @relation("VendorQuotations", fields: [vendorId], references: [id], onDelete: Cascade)
  customer User          @relation("CustomerQuotations", fields: [customerId], references: [id], onDelete: Cascade)
  items    QuotationItem[]
  booking  Booking?
  messages OfferMessage[]
  history  QuotationHistory[]

  @@index([eventId])
  @@index([vendorId])
  @@index([customerId])
  @@index([status])
  @@index([origin])
}

model QuotationHistory {
  id          String           @id @default(cuid())
  quotationId String
  actorId     String?
  action      String // created | sent | revised | accepted | rejected | revision_requested | declined
  fromStatus  QuotationStatus?
  toStatus    QuotationStatus?
  note        String?
  createdAt   DateTime         @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  actor     User?     @relation("QuotationHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([quotationId, createdAt])
}

model OfferMessage {
  id          String   @id @default(cuid())
  quotationId String
  senderId    String
  body        String
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sender    User      @relation("OfferMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([quotationId, createdAt])
  @@index([senderId])
}

model QuotationItem {
  id          String @id @default(cuid())
  quotationId String
  name        String // snapshot nama, bukan FK — harga historis stabil
  description String?
  quantity    Int
  unitPrice   Int
  subtotal    Int
  /// Menu sumber (untuk lembar produksi). Kosong untuk baris paket/kustom.
  menuItemId  String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  menuItem  MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

model Booking {
  id              String        @id @default(cuid())
  eventId         String
  quotationId     String        @unique
  vendorId        String
  customerId      String
  status          BookingStatus @default(CONFIRMED)
  totalAmount     Int // snapshot dari quotation.total
  depositAmount   Int
  remainingAmount Int
  confirmedAt     DateTime?
  /// Batas waktu pelunasan; lewat dari ini booking dibatalkan otomatis dan kapasitas dilepas.
  paymentDueAt    DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledBy     String? // CUSTOMER | VENDOR | SYSTEM
  refundAmount    Int?
  refundedAt      DateTime?
  /// Pengingat batas bayar sudah dikirim (agar tidak dobel).
  paymentReminderSentAt DateTime?
  /// Progres otomatis: vendor berangkat antar, pelanggan konfirmasi terima.
  departedAt      DateTime?
  receivedAt      DateTime?
  completedBy     String? // CUSTOMER | VENDOR | SYSTEM
  lateReminderSentAt DateTime?
  /// Nomor invoice berurutan per vendor per tahun, cth. INV/DN/2026/0007.
  invoiceNumber   String?       @unique
  source          String        @default("ONLINE") // ONLINE | OFFLINE
  offlineCustomerName  String?
  offlineCustomerPhone String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  quotation Quotation    @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  vendor   VendorProfile @relation("VendorBookings", fields: [vendorId], references: [id], onDelete: Restrict)
  customer User          @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  payments Payment[]
  review   Review?

  @@index([vendorId])
  @@index([customerId])
  @@index([status])
  @@index([status, paymentDueAt])
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String
  provider          String        @default("mock")
  providerReference String        @unique
  amount            Int
  method            String        @default("QRIS")
  status            PaymentStatus @default(PENDING)
  qrPayload         String? // QR string / checkout URL snapshot
  expiresAt         DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  customerId String
  vendorId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  booking  Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @default("INFO")
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Outbox WhatsApp: ditulis dalam transaksi yang sama dengan notifikasi,
/// lalu dikirim oleh dispatcher lewat provider (saat ini: mock).
model WhatsAppMessage {
  id         String    @id @default(cuid())
  userId     String?
  toPhone    String?   // format 62xxxxxxxxxx
  body       String
  event      String
  status     String    @default("QUEUED") // QUEUED | SENT | FAILED | SKIPPED
  provider   String?
  providerMessageId String?
  error      String?
  attempts   Int       @default(0)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([toPhone, createdAt])
}

/// Penghitung nomor invoice per vendor per tahun (diinkremen atomik).
model InvoiceCounter {
  vendorId String
  year     Int
  last     Int    @default(0)

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([vendorId, year])
}
