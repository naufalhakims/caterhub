# ===== Database =====
# Dipakai backend (Prisma). API berhenti saat start bila kosong.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caterhub?schema=public"

# ===== Auth =====
# JWT HS256; dipakai API untuk menandatangani dan Next untuk memverifikasi.
# WAJIB diganti di produksi (minimal 32 karakter acak, bukan placeholder).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="dev-only-insecure-secret-change-me-please-32"

# ===== API Express =====
API_PORT="4000"
# Origin browser yang boleh memanggil API (pisahkan koma bila lebih dari satu).
CORS_ORIGIN="http://localhost:3000"
# URL publik frontend (dipakai untuk referensi/webhook).
APP_URL="http://localhost:3000"

# ===== Frontend =====
# Alamat API yang dipanggil Next (server-side). Default di kode: http://127.0.0.1:4000
API_BASE_URL="http://127.0.0.1:4000"

# ===== Unggahan =====
# Path relatif terhadap root repo.
# Dokumen verifikasi privat (JANGAN di dalam public).
UPLOAD_DIR="backend/storage/private"
# Gambar publik (logo, cover, galeri, menu, paket).
PUBLIC_UPLOAD_DIR="backend/public/uploads"

# ===== Pembayaran (opsional; kosong = mock) =====
PAYMENT_PROVIDER="mock"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_WEBHOOK_SECRET=""

# Webhook mock TIDAK terautentikasi: default ditolak.
# Alur demo memakai /api/payments/mock-settle yang membutuhkan login + kepemilikan.
ALLOW_MOCK_WEBHOOK="false"
