# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caterhub?schema=public"

# Auth.js
# WAJIB diganti di produksi (minimal 32 karakter acak). Build produksi gagal bila
# masih memakai nilai contoh ini.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-secret-random-min-32-karakter"
AUTH_URL="http://localhost:3000"

# Payment (isi saat pakai Midtrans sandbox; kosong = mock adapter)
PAYMENT_PROVIDER="mock"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_WEBHOOK_SECRET=""

# Keamanan payment
# Webhook mock TIDAK terautentikasi: default ditolak. Jangan aktifkan di produksi.
# Alur demo memakai /api/payments/mock-settle yang membutuhkan login.
ALLOW_MOCK_WEBHOOK="false"

# Upload (opsional)
# Folder penyimpanan dokumen verifikasi privat + gambar. Default: ./storage
# Di Vercel filesystem read-only/tidak persisten — gunakan object storage.
# UPLOAD_DIR="./storage"
